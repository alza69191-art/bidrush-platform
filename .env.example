# TiDB Cloud connection — set these as Railway service variables.
# Never commit real credentials or place them in client-side code.
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD
DB_NAME=bidrush
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
APP_URL=https://YOUR-RAILWAY-DOMAIN
NODE_ENV=production
